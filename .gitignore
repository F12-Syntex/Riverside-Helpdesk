/node_modules
node_modules/
/.next
/out
/build
.env*.local
*.log
.DS_Store

# design-sync: staged converter, its build output, and machine-local state.
# Everything else under .design-sync/ is committed — it is the sync's input.
/.ds-sync
/ds-bundle
/.design-sync/dist
/.design-sync/.cache
/.design-sync/learnings
/.design-sync/node_modules

# Notebook backups hold live practice content (and, until they are rotated,
# shared credentials). Never commit one.
scripts/notebook-backup.json

# The Chrome extension: build output, and the signed package that CI publishes.
/extension/dist
/extension/dist-pack
/release

# The extension's signing key. It fixes the extension's id for life and lives
# in the CRX_PRIVATE_KEY GitHub Actions secret — never in the repository.
*.pem

# Real staff questions, dumped out of question_log by `npm run routing:questions`
# for labelling into the router's golden set. The questions are redacted of
# names and addresses before they are ever stored, but they are still what
# somebody typed about practice business, so they stay out of the repository.
# What IS committed is evals/routing/pages.md — the labelled cases, chosen
# deliberately.
/evals/routing/questions*.txt
