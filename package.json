{
  "name": "riverside-emis-helper",
  "version": "5.23.0",
  "private": true,
  "description": "Riverside Practice Q&A: a document-grounded reception assistant for The Riverside Practice, using OpenRouter.",
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev -H 127.0.0.1",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "pdf:worker": "node scripts/copy-pdf-worker.mjs",
    "start": "next start",
    "test": "node --test",
    "lint": "next lint",
    "rag:status": "node rag/status.mjs",
    "rag:ingest": "node rag/ingest.mjs",
    "rag:prune": "node rag/prune.mjs",
    "rag:sync": "node rag/ingest.mjs && node rag/prune.mjs",
    "rag:migrate-legacy": "node rag/migrate-legacy.mjs",
    "db:reset-rota": "node scripts/reset-and-seed-rota.mjs",
    "data:cqc": "node scripts/build-cqc-directory.mjs",
    "data:one-templates": "node scripts/build-one-templates.mjs",
    "data:nel-tree": "node scripts/build-nel-referral-tree.mjs",
    "data:nel-contracts": "node scripts/build-nel-contracts.mjs",
    "data:ers": "node scripts/ingest-snomed-ers.mjs",
    "versions": "node scripts/versions.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "@vercel/functions": "^3.7.5",
    "ai": "^7.0.37",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^14.2.35",
    "pdfjs-dist": "^6.0.227",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tiptap-markdown": "^0.8.10",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
